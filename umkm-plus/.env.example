# Database PostgreSQL (Neon/Supabase). Kosongkan saat pengembangan lokal: otomatis memakai PGlite di folder .data/
DATABASE_URL=

# Kunci rahasia untuk sesi login, minimal 32 karakter acak. Wajib di produksi.
SESSION_SECRET=

# Kunci API Claude untuk fitur AI caption (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Kunci API Google (Google AI Studio) untuk gambar AI (Gemini) dan membaca folder Google Drive.
GOOGLE_API_KEY=
# Opsional: ganti model pembuat gambar jika Google merilis model baru.
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Iklan otomatis Meta (Facebook & Instagram). Lihat README bagian "Iklan otomatis di Meta Ads".
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_PAGE_ID=
# Opsional: akun Instagram untuk tampil di Instagram (bila kosong, Meta memakai identitas Page).
META_INSTAGRAM_USER_ID=
# Opsional tapi disarankan bila "Require App Secret" aktif di aplikasi Meta.
META_APP_SECRET=
# Opsional: versi Graph API (bawaan v25.0).
META_GRAPH_VERSION=v25.0
# Kunci untuk pengecekan harian otomatis (Vercel Cron) — teks acak bebas.
CRON_SECRET=
